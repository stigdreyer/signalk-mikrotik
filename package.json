{
  "name": "signalk-mikrotik",
  "version": "1.0.1",
  "description": "Meters the boat's data on a MikroTik router and, while the connection is metered, locks the router down to an allowlist",
  "main": "index.js",
  "license": "EUPL-1.2",
  "author": "Stig Dreyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stigdreyer/signalk-mikrotik.git"
  },
  "homepage": "https://github.com/stigdreyer/signalk-mikrotik#readme",
  "bugs": {
    "url": "https://github.com/stigdreyer/signalk-mikrotik/issues"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp",
    "mikrotik",
    "routeros",
    "starlink",
    "metered"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:v2fly": "node tools/build-v2fly.js"
  },
  "files": [
    "index.js",
    "lib",
    "profiles",
    "data",
    "public",
    "docs",
    "CHANGELOG.md"
  ],
  "signalk": {
    "displayName": "MikroTik Data Meter",
    "appIcon": "./assets/icons/icon-72x72.png",
    "requires": [
      "@meri-imperiumi/signalk-internet"
    ],
    "recommends": [
      "signalk-starlink-offshore",
      "signalk-starlink",
      "signalk-derived-data",
      "@signalk/freeboard-sk"
    ],
    "screenshots": [
      "./docs/screenshots/allowlist.png",
      "./docs/screenshots/data-usage.png",
      "./docs/screenshots/night.png",
      "./docs/screenshots/setup.png"
    ]
  },
  "dependencies": {
    "@meri-imperiumi/signalk-internet": "^0.8.0"
  },
  "signalk-plugin-enabled-by-default": true
}
