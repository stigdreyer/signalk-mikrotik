{
  "name": "MikroTik Data Meter",
  "short_name": "Data Meter",
  "description": "Data usage and the allowlist for a MikroTik router on a metered connection, from Signal K.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1A1A19",
  "theme_color": "#1A1A19",
